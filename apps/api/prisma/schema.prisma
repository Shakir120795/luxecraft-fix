// LuxeCraft — Prisma Schema
// Phase 5: Checkout, Payments, Shipping & Orders
// Phase 1, 2, 3 & 4 models retained.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// FOUNDATION — Phase 1
// ============================================================

model SchemaVersion {
  id          Int      @id @default(autoincrement())
  version     String   @unique
  description String
  appliedAt   DateTime @default(now())

  @@map("schema_versions")
}

// ============================================================
// AUTHENTICATION — Phase 2
// ============================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?
  passwordHash      String?
  firstName         String?
  lastName          String?
  phone             String?
  country           String?
  status            UserStatus @default(ACTIVE)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  sessions          Session[]
  otpCodes          OtpCode[]
  passwordResets    PasswordResetToken[]
  loginAttempts     LoginAttempt[]
  carts             Cart[]
  wishlists         Wishlist[]
  addresses         Address[]
  orders            Order[]
  customRequests    CustomRequest[]
  reviews           Review[]

  @@index([email])
  @@index([status])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

model OtpCode {
  id         String      @id @default(cuid())
  userId     String?
  email      String
  code       String
  purpose    OtpPurpose
  used       Boolean     @default(false)
  attempts   Int         @default(0)
  expiresAt  DateTime
  createdAt  DateTime    @default(now())
  usedAt     DateTime?

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, purpose])
  @@index([code])
  @@index([expiresAt])
  @@map("otp_codes")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  CHECKOUT_VERIFICATION
  LOGIN_VERIFICATION
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  used      Boolean   @default(false)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model LoginAttempt {
  id          String   @id @default(cuid())
  email       String
  userId      String?
  ipAddress   String?
  userAgent   String?
  success     Boolean
  failReason  String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_attempts")
}

model AdminUser {
  id                  String          @id @default(cuid())
  email               String          @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                AdminRole       @default(SUPER_ADMIN)
  status              AdminStatus     @default(ACTIVE)
  twoFactorEnabled    Boolean         @default(false)
  twoFactorSecret     String?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int             @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  createdBy           String?

  sessions            AdminSession[]
  auditLogs           AuditLog[]
  inventoryLogs       InventoryLog[]

  @@index([email])
  @@index([status])
  @@map("admin_users")
}

enum AdminRole {
  SUPER_ADMIN
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

model AdminSession {
  id           String      @id @default(cuid())
  adminId      String
  refreshToken String      @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime    @default(now())

  admin        AdminUser   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([refreshToken])
  @@map("admin_sessions")
}

model AuditLog {
  id         String     @id @default(cuid())
  adminId    String?
  actor      String?
  actorType  String     @default("system")
  action     String
  resource   String
  resourceId String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([actor])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// CATALOG — Phase 3
// ============================================================

/// Product category. Supports hierarchy (parentId), ordering, SEO, image, soft-delete.
model Category {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  description   String?
  parentId      String?
  sortOrder     Int             @default(0)
  status        CategoryStatus  @default(ACTIVE)

  // Image — either uploaded (stored in object storage) or external URL
  imageUrl      String?
  imageKey      String?         // S3/R2 object key if uploaded
  imageAlt      String?

  // SEO
  seoTitle      String?
  seoDesc       String?

  // Timestamps & soft-delete
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  archivedAt    DateTime?
  deletedAt     DateTime?       // soft-delete; null = not deleted

  // Relations
  parent        Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[]      @relation("CategoryTree")
  products      Product[]

  @@index([slug])
  @@index([status])
  @@index([parentId])
  @@index([sortOrder])
  @@map("categories")
}

enum CategoryStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
}

/// Product. Linked to a category. Supports variants, media, customization, SEO, soft-delete.
model Product {
  id               String          @id @default(cuid())
  categoryId       String?
  name             String
  slug             String          @unique
  sku              String?         @unique
  description      String?
  shortDescription String?

  // Pricing (base — variants can override)
  regularPrice     Decimal         @db.Decimal(12, 2)
  salePrice        Decimal?        @db.Decimal(12, 2)
  currency         String          @default("USD")

  // Status & visibility
  status           ProductStatus   @default(DRAFT)

  // Physical dimensions (base — variants can override)
  weightKg         Decimal?        @db.Decimal(8, 3)
  lengthCm         Decimal?        @db.Decimal(8, 2)
  widthCm          Decimal?        @db.Decimal(8, 2)
  heightCm         Decimal?        @db.Decimal(8, 2)

  // SEO
  seoTitle         String?
  seoDesc          String?

  // Flags
  trackInventory   Boolean         @default(true)
  allowBackorder   Boolean         @default(false)
  isFeatured       Boolean         @default(false)
  isCustomizable   Boolean         @default(false)

  // Timestamps & soft-delete
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  publishedAt      DateTime?
  archivedAt       DateTime?
  deletedAt        DateTime?

  // Relations
  category         Category?       @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  media            ProductMedia[]
  customizationOptions ProductCustomizationOption[]
  inventoryLogs    InventoryLog[]
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]

  reviews          Review[]

  @@index([categoryId])
  @@index([slug])
  @@index([sku])
  @@index([status])
  @@index([isFeatured])
  @@map("products")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

/// A specific variant of a product (e.g. 5x7 / Standard, 8x10 / Premium).
model ProductVariant {
  id             String    @id @default(cuid())
  productId      String
  name           String                    // e.g. "8x10 / Premium"
  sku            String?   @unique
  sortOrder      Int       @default(0)

  // Pricing (overrides product if set)
  regularPrice   Decimal?  @db.Decimal(12, 2)
  salePrice      Decimal?  @db.Decimal(12, 2)

  // Physical (overrides product if set)
  weightKg       Decimal?  @db.Decimal(8, 3)
  lengthCm       Decimal?  @db.Decimal(8, 2)
  widthCm        Decimal?  @db.Decimal(8, 2)
  heightCm       Decimal?  @db.Decimal(8, 2)

  // Inventory
  stockQty       Int       @default(0)
  reservedQty    Int       @default(0)
  lowStockAt     Int?      // threshold for low-stock alert
  trackInventory Boolean   @default(true)
  allowBackorder Boolean   @default(false)
  isAvailable    Boolean   @default(true)

  // Timestamps & soft-delete
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // Relations
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLogs  InventoryLog[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]

  @@index([productId])
  @@index([sku])
  @@index([sortOrder])
  @@map("product_variants")
}

/// Product image or video. Supports both uploaded files and external URLs.
model ProductMedia {
  id          String         @id @default(cuid())
  productId   String
  type        MediaType      @default(IMAGE)
  url         String                           // CDN or external URL (always set)
  storageKey  String?                          // object-storage key if uploaded
  altText     String?
  sortOrder   Int            @default(0)
  isMain      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isMain])
  @@index([sortOrder])
  @@map("product_media")
}

enum MediaType {
  IMAGE
  VIDEO
}

/// Predefined customization options (e.g. Size, Color, Material) with optional price delta.
model ProductCustomizationOption {
  id           String    @id @default(cuid())
  productId    String
  groupName    String                  // e.g. "Size", "Color", "Material"
  optionLabel  String                  // e.g. "Large", "Red", "Silk"
  priceDelta   Decimal   @default(0) @db.Decimal(10, 2)
  sortOrder    Int       @default(0)
  isAvailable  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([groupName])
  @@map("product_customization_options")
}

/// Inventory adjustment history. Covers manual adjustments, order reservations, and releases.
model InventoryLog {
  id          String           @id @default(cuid())
  productId   String?
  variantId   String?
  adminId     String?
  changeType  InventoryChange
  delta       Int                        // positive = stock in, negative = stock out
  qtyBefore   Int
  qtyAfter    Int
  reason      String?
  reference   String?                    // order ID, return ID, etc.
  createdAt   DateTime         @default(now())

  product     Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant     ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  admin       AdminUser?       @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([changeType])
  @@index([createdAt])
  @@map("inventory_logs")
}

enum InventoryChange {
  MANUAL_ADJUST
  ORDER_RESERVE
  ORDER_RELEASE
  ORDER_DEDUCT
  RETURN_RESTOCK
  INITIAL_STOCK
  CORRECTION
}

// ============================================================
// CART & WISHLIST — Phase 4
// ============================================================

/// Shopping cart. Supports guest (sessionId) and customer (userId) carts.
model Cart {
  id          String    @id @default(cuid())
  userId      String?                   // null = guest cart
  sessionId   String?   @unique          // for guest carts
  currency    String    @default("USD")
  expiresAt   DateTime?                 // cart expiry for guest carts
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("carts")
}

/// Cart item. References product + optional variant. Stores customization snapshot.
model CartItem {
  id              String    @id @default(cuid())
  cartId          String
  productId       String
  variantId       String?
  quantity        Int       @default(1)
  customization   Json?                 // selected customization options snapshot
  priceSnapshot   Decimal   @db.Decimal(12, 2)  // price at time of add-to-cart
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cart            Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

/// Customer wishlist. Customer-only feature.
model Wishlist {
  id          String    @id @default(cuid())
  userId      String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       WishlistItem[]

  @@map("wishlists")
}

/// Wishlist item. References product + optional variant.
model WishlistItem {
  id          String    @id @default(cuid())
  wishlistId  String
  productId   String
  variantId   String?
  createdAt   DateTime  @default(now())

  wishlist    Wishlist          @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([wishlistId, productId, variantId])
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_items")
}

// ============================================================
// CHECKOUT, PAYMENTS, SHIPPING & ORDERS — Phase 5
// ============================================================

/// Customer address. Supports billing and shipping addresses.
model Address {
  id              String    @id @default(cuid())
  userId          String?                     // null for guest checkout addresses
  type            AddressType @default(SHIPPING)
  firstName       String
  lastName        String
  company         String?
  addressLine1    String
  addressLine2    String?
  city            String
  stateProvince   String?
  postalCode      String
  country         String                      // ISO country code (e.g. "US", "IN", "GB")
  phone           String?
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ordersShipping  Order[]   @relation("ShippingAddress")
  ordersBilling   Order[]   @relation("BillingAddress")

  @@index([userId])
  @@index([country])
  @@map("addresses")
}

enum AddressType {
  SHIPPING
  BILLING
  BOTH
}

/// Shipping zone. Defines a region for shipping pricing.
model ShippingZone {
  id          String    @id @default(cuid())
  name        String                        // e.g. "US Domestic", "EU", "Worldwide"
  countries   String[]                      // array of ISO country codes
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  methods     ShippingMethod[]

  @@map("shipping_zones")
}

/// Shipping method within a zone.
model ShippingMethod {
  id                String    @id @default(cuid())
  zoneId            String
  name              String                  // e.g. "Standard", "Express", "Overnight"
  description       String?
  deliveryDaysMin   Int?
  deliveryDaysMax   Int?
  basePrice         Decimal   @db.Decimal(10, 2)
  pricePerKg        Decimal   @default(0) @db.Decimal(10, 2)
  freeShippingMin   Decimal?  @db.Decimal(10, 2)  // free if order total >= this
  isActive          Boolean   @default(true)
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  zone              ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  orders            Order[]

  @@index([zoneId])
  @@map("shipping_methods")
}

/// Tax rule. Supports country/region-specific tax rates (VAT, GST, sales tax).
model TaxRule {
  id            String    @id @default(cuid())
  country       String                      // ISO country code
  stateProvince String?                     // optional for state/province-level tax
  taxType       String    @default("VAT")   // VAT, GST, Sales Tax, etc.
  taxRate       Decimal   @db.Decimal(5, 2) // percentage (e.g. 20.00 for 20%)
  isInclusive   Boolean   @default(false)   // true = price includes tax
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([country, stateProvince])
  @@index([country])
  @@map("tax_rules")
}

/// Order. Central order model for standard and custom orders.
model Order {
  id                  String       @id @default(cuid())
  orderNumber         String       @unique               // e.g. "ORD-1001"
  userId              String?                            // null for guest orders
  guestEmail          String?

  // Order type
  orderType           OrderType    @default(STANDARD)

  // Status
  orderStatus         OrderStatus  @default(PENDING)
  paymentStatus       PaymentStatus @default(PENDING)
  fulfillmentStatus   FulfillmentStatus @default(UNFULFILLED)

  // Addresses (historical snapshots stored in JSON)
  shippingAddressId   String?
  billingAddressId    String?
  shippingSnapshot    Json                               // snapshot of shipping address at order time
  billingSnapshot     Json                               // snapshot of billing address at order time

  // Pricing (all in order currency)
  currency            String       @default("USD")
  subtotal            Decimal      @db.Decimal(12, 2)
  shippingCost        Decimal      @db.Decimal(10, 2)
  taxAmount           Decimal      @db.Decimal(10, 2)
  discountAmount      Decimal      @default(0) @db.Decimal(10, 2)
  total               Decimal      @db.Decimal(12, 2)

  // Shipping
  shippingMethodId    String?
  shippingMethodName  String?                            // snapshot of method name
  trackingNumber      String?

  // Notes
  customerNotes       String?
  adminNotes          String?

  // Timestamps
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  paidAt              DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?

  // Relations
  user                User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingAddress     Address?     @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress      Address?     @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  shippingMethod      ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]

  @@index([orderNumber])
  @@index([userId])
  @@index([guestEmail])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

enum OrderType {
  STANDARD
  CUSTOM
}

enum OrderStatus {
  PENDING
  PAYMENT_CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
  REFUNDED
  RETURNED
  ON_HOLD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

/// Order item. Historical snapshot of product/variant/customization at purchase time.
model OrderItem {
  id                String    @id @default(cuid())
  orderId           String
  productId         String?                           // may be null if product deleted
  variantId         String?
  
  // Historical snapshots
  productSnapshot   Json                              // product name, SKU, description, etc.
  variantSnapshot   Json?                             // variant details if applicable
  customization     Json?                             // selected customization options

  quantity          Int
  unitPrice         Decimal   @db.Decimal(12, 2)      // price per unit at purchase time
  totalPrice        Decimal   @db.Decimal(12, 2)      // quantity * unitPrice
  
  createdAt         DateTime  @default(now())

  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Payment. Payment record with provider abstraction.
model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String                            // e.g. "stripe", "paypal", "razorpay"
  providerPaymentId String?                           // provider's payment ID
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)
  paymentMethod     String?                           // e.g. "card", "upi", "wallet"
  
  // Metadata
  metadata          Json?                             // provider-specific data
  
  // Refund
  refundedAmount    Decimal       @default(0) @db.Decimal(12, 2)
  
  // Timestamps
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paidAt            DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?

  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([status])
  @@map("payments")
}

// ============================================================
// LUXURY CUSTOM DESIGN ENGINE — Phase 6
// ============================================================

/// Custom request. Customer submits bespoke design requirements.
model CustomRequest {
  id              String          @id @default(cuid())
  customRequestNumber String       @unique             // e.g. "CR-1001"
  userId          String
  productId       String?         // reference product/category if applicable
  categoryId      String?

  // Request details
  title           String          // brief title of the custom design
  description     String          // detailed design requirements
  dimensions      String?         // e.g. "5x7 ft", "custom size 3m x 2m"
  designNotes     String?         // additional design instructions
  preferredColors String?         // color preferences
  materialPreference String?      // material preferences
  quantityRequested Int?          // if known
  budgetRange     String?         // e.g. "$500-$1000" for customer reference
  
  // Status
  status          CustomRequestStatus @default(SUBMITTED)
  
  // Approval
  approvedDesignId String?        // link to approved design (when ready for checkout)
  
  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        CustomMessage[]
  quotes          CustomQuote[]
  designs         CustomDesign[]

  @@index([userId])
  @@index([status])
  @@index([customRequestNumber])
  @@map("custom_requests")
}

enum CustomRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  IN_PROGRESS
  AWAITING_APPROVAL
  APPROVED
  CANCELLED
  COMPLETED
}

/// Custom message. Communication between customer and admin.
model CustomMessage {
  id              String          @id @default(cuid())
  customRequestId String
  senderId        String          // user ID or admin ID
  senderType      SenderType      @default(CUSTOMER)
  message         String
  attachments     String[]        // array of file URLs/keys
  isRead          Boolean         @default(false)
  readAt          DateTime?
  createdAt       DateTime        @default(now())

  customRequest   CustomRequest   @relation(fields: [customRequestId], references: [id], onDelete: Cascade)

  @@index([customRequestId])
  @@index([senderId])
  @@index([isRead])
  @@map("custom_messages")
}

enum SenderType {
  CUSTOMER
  ADMIN
  SYSTEM
}

/// Custom quote. Pricing proposal for custom work.
model CustomQuote {
  id              String          @id @default(cuid())
  customRequestId String
  quoteNumber     String          @unique             // e.g. "QT-1001"
  version         Int             @default(1)         // version tracking (v1, v2, etc.)
  
  // Pricing breakdown
  baseProductPrice Decimal        @db.Decimal(12, 2)
  designFee       Decimal         @db.Decimal(12, 2)
  materialFee     Decimal         @db.Decimal(12, 2)  // for special materials
  dimensionFee    Decimal         @db.Decimal(12, 2)  // for custom dimensions
  rushFee         Decimal         @default(0) @db.Decimal(12, 2)  // rush order
  subtotal        Decimal         @db.Decimal(12, 2)
  discount        Decimal         @default(0) @db.Decimal(12, 2)
  shippingEstimate Decimal        @default(0) @db.Decimal(12, 2)
  taxEstimate     Decimal         @default(0) @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  currency        String          @default("USD")
  
  // Details
  description     String?         // quote notes/justification
  
  // Status & approval
  status          QuoteStatus     @default(DRAFT)
  customerStatus  QuoteStatus     @default(PENDING)   // customer response
  expiresAt       DateTime?       // quote validity period
  
  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  customRequest   CustomRequest   @relation(fields: [customRequestId], references: [id], onDelete: Cascade)

  @@unique([customRequestId, version])
  @@index([customRequestId])
  @@index([quoteNumber])
  @@index([status])
  @@map("custom_quotes")
}

enum QuoteStatus {
  DRAFT
  PENDING           // awaiting customer response
  ACCEPTED
  REJECTED
  REVISED
  EXPIRED
}

/// Custom design. Design files and versions.
model CustomDesign {
  id              String          @id @default(cuid())
  customRequestId String
  version         Int             @default(1)         // v1, v2, etc.
  
  // Design files
  designFileUrl   String                              // design file URL (uploaded to storage)
  designFileKey   String?                             // object storage key if uploaded
  designPreviewUrl String?                            // preview image URL
  
  // Details
  description     String?         // design description/notes
  uploadedBy      String          // admin ID who uploaded
  
  // Approval
  approvalStatus  DesignApprovalStatus @default(PENDING)
  approvedAt      DateTime?
  approvedBy      String?         // customer ID who approved
  rejectionReason String?         // if rejected
  
  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  customRequest   CustomRequest   @relation(fields: [customRequestId], references: [id], onDelete: Cascade)

  @@unique([customRequestId, version])
  @@index([customRequestId])
  @@index([approvalStatus])
  @@map("custom_designs")
}

enum DesignApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
}



// ============================================================
// COUPONS, REVIEWS, NOTIFICATIONS — Phase 7
// ============================================================

/// Coupon. Percentage or fixed discount with restrictions.
model Coupon {
  id              String        @id @default(cuid())
  code            String        @unique
  discountType    String        @default("PERCENTAGE") // PERCENTAGE or FIXED
  discountValue   Decimal       @db.Decimal(10, 2)    // percentage (e.g., 10 for 10%) or fixed amount
  currency        String        @default("USD")
  
  // Restrictions
  minOrderAmount  Decimal?      @db.Decimal(12, 2)
  maxUsageCount   Int?          // null = unlimited
  usedCount       Int           @default(0)
  maxPerCustomer  Int?          // null = unlimited
  applicableProducts String[]   // array of product IDs; empty = all products
  applicableCategories String[] // array of category IDs; empty = all categories
  
  // Validity
  validFrom       DateTime
  validTo         DateTime?
  isActive        Boolean       @default(true)
  
  // Metadata
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

/// Review. Customer product review.
model Review {
  id              String        @id @default(cuid())
  productId       String
  userId          String?
  rating          Int                          // 1-5
  title           String?
  content         String?
  status          String        @default("PENDING") // PENDING, APPROVED, HIDDEN, REJECTED
  isFeatured      Boolean       @default(false)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([status])
  @@map("reviews")
}

/// Notification. System notifications for customers and admins.
model Notification {
  id              String        @id @default(cuid())
  recipientId     String        // user ID or admin ID
  type            String        // ORDER_PLACED, PAYMENT_CONFIRMED, CUSTOM_REQUEST_UPDATE, QUOTE_READY, DESIGN_APPROVED, etc.
  title           String
  message         String
  relatedId       String?       // order ID, custom request ID, etc.
  read            Boolean       @default(false)
  readAt          DateTime?
  
  createdAt       DateTime      @default(now())

  @@index([recipientId])
  @@index([type])
  @@index([read])
  @@map("notifications")
}


// ============================================================
// ANALYTICS & OBSERVABILITY — Phase 8
// ============================================================

/// Analytics event. Tracks visitor behavior funnel.
model AnalyticsEvent {
  id              String        @id @default(cuid())
  eventType       String        // VISITOR_LANDED, PRODUCT_VIEWED, CATEGORY_VIEWED, ITEM_ADDED_TO_CART, CHECKOUT_STARTED, PURCHASE_COMPLETED, ABANDONED_CART
  userId          String?       // null for guests
  sessionId       String?       // guest session tracking
  
  // Context
  productId       String?       // if product-related
  categoryId      String?       // if category-related
  orderId         String?       // if purchase-related
  
  // Environment
  country         String?       // geo-location
  device          String?       // mobile, desktop, tablet
  browser         String?       // user agent
  referrer        String?       // traffic source
  
  // Metadata
  metadata        Json?         // event-specific data
  
  createdAt       DateTime      @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("analytics_events")
}
