# ============================================================
# LuxeCraft — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----- Application ------------------------------------------
NODE_ENV=development
# API port
API_PORT=3001
# Storefront port
STOREFRONT_PORT=3000
# Admin port
ADMIN_PORT=3002

# ----- API Base URLs ----------------------------------------
# Used by Next.js apps to reach the backend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Internal URL (server-side Next.js → API, inside Docker)
API_INTERNAL_URL=http://localhost:3001/api/v1

# ----- Database (PostgreSQL) --------------------------------
POSTGRES_USER=luxecraft
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=luxecraft_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Prisma connection URL
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ----- Redis ------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_in_production
# Full Redis URL (alternative to host/port/password)
REDIS_URL=redis://:change_me_in_production@localhost:6379

# ----- JWT / Auth -------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ----- Admin Auth -------------------------------------------
# Separate secret for admin JWT tokens (MUST differ from JWT_SECRET)
ADMIN_JWT_SECRET=change_me_to_a_separate_admin_secret_in_production
ADMIN_JWT_EXPIRES_IN=8h
ADMIN_JWT_REFRESH_SECRET=change_me_to_admin_refresh_secret_in_production
ADMIN_JWT_REFRESH_EXPIRES_IN=7d

# ----- Seed (initial Super Admin) ---------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe@Admin1!
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin

# ----- CORS -------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# ----- Object Storage (S3-compatible) -----------------------
# Provider: aws | r2 | spaces | custom
STORAGE_PROVIDER=custom
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=change_me
STORAGE_SECRET_KEY=change_me
STORAGE_BUCKET_PUBLIC=luxecraft-public
STORAGE_BUCKET_PRIVATE=luxecraft-private
# Public CDN base URL for media (leave blank to use storage URL directly)
STORAGE_CDN_URL=

# ----- Email ------------------------------------------------
# Provider: smtp | ses | sendgrid | postmark | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@luxecraft.com
EMAIL_FROM_NAME=LuxeCraft
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ----- OTP / Verification -----------------------------------
OTP_EXPIRES_MINUTES=10
OTP_LENGTH=6

# ----- Payment (TBD — provider not yet selected) ------------
# PAYMENT_PROVIDER=stripe
# PAYMENT_SECRET_KEY=change_me
# PAYMENT_WEBHOOK_SECRET=change_me
# PAYMENT_PUBLIC_KEY=change_me

# ----- Shipping (TBD — provider not yet selected) -----------
# SHIPPING_PROVIDER=shiprocket
# SHIPPING_API_KEY=change_me

# ----- Rate Limiting ----------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ----- Analytics (TBD) -------------------------------------
# ANALYTICS_PROVIDER=custom

# ----- Logging ----------------------------------------------
LOG_LEVEL=debug

# ----- Health Check -----------------------------------------
HEALTH_CHECK_SECRET=change_me_health_secret
