# LuxeCraft Production Environment Variables
# Copy this file to .env.production and fill in the values

# ============================================
# DATABASE
# ============================================
DB_USER=luxecraft
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
DATABASE_URL=postgresql://luxecraft:CHANGE_ME_STRONG_PASSWORD_HERE@localhost:5432/luxecraft_prod?schema=public

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ============================================
# JWT SECRETS (Customer Auth)
# Generate with: openssl rand -base64 64
# ============================================
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_HERE
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_STRONG_REFRESH_SECRET_HERE
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# ADMIN JWT SECRETS (Admin Auth - SEPARATE!)
# Generate with: openssl rand -base64 64
# ============================================
ADMIN_JWT_SECRET=CHANGE_ME_ADMIN_JWT_SECRET_HERE
ADMIN_JWT_EXPIRES_IN=8h
ADMIN_JWT_REFRESH_SECRET=CHANGE_ME_ADMIN_REFRESH_SECRET_HERE
ADMIN_JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# INITIAL SUPER ADMIN ACCOUNT
# ============================================
SUPER_ADMIN_EMAIL=admin@luxecraft.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_HERE
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# ============================================
# CORS & SECURITY
# ============================================
CORS_ORIGINS=https://luxecraft.com,https://admin.luxecraft.com
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
PORT=3001
APP_NAME=LuxeCraft
APP_URL=https://api.luxecraft.com

# ============================================
# EMAIL (Configure your provider)
# ============================================
EMAIL_FROM=noreply@luxecraft.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password

# ============================================
# PAYMENT GATEWAY (Configure your provider)
# ============================================
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...

# ============================================
# OBJECT STORAGE (Configure your provider)
# ============================================
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=luxecraft-images
# OR
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...

# ============================================
# FRONTEND URLS
# ============================================
NEXT_PUBLIC_API_URL=https://api.luxecraft.com/api/v1
NEXT_PUBLIC_STOREFRONT_URL=https://luxecraft.com
NEXT_PUBLIC_ADMIN_URL=https://admin.luxecraft.com
NEXT_PUBLIC_SITE_NAME=LuxeCraft

# ============================================
# MONITORING & ANALYTICS (Optional)
# ============================================
# SENTRY_DSN=...
# GOOGLE_ANALYTICS_ID=...
# HOTJAR_ID=...

# ============================================
# BACKUP CONFIGURATION
# ============================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
