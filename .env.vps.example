# Copy to .env.vps on the VPS. Never commit the copied file.
STOREFRONT_HOST=shop.example.com
ADMIN_HOST=admin.example.com

POSTGRES_DB=luxecraft
POSTGRES_USER=luxecraft
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-a-64-character-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-character-random-secret
ADMIN_JWT_SECRET=replace-with-a-different-64-character-random-secret
ADMIN_JWT_REFRESH_SECRET=replace-with-a-different-64-character-random-secret

SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-unique-password
SUPER_ADMIN_FIRST_NAME=Store
SUPER_ADMIN_LAST_NAME=Owner

# Add credentials for a selected provider later; never commit the filled .env.vps.
PAYMENT_PROVIDER=none
EMAIL_PROVIDER=none
STORAGE_PROVIDER=local
DEFAULT_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,INR
SUPPORTED_COUNTRIES=IN,US
